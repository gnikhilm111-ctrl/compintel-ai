# =========================================================
# CompIntel AI - Server Environment Variables Template
# =========================================================

# Groq LLM API Key (Obtain your free API key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Hindsight Memory Engine Configuration (Optional API Key / Endpoint)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_ENDPOINT=http://localhost:5000/api/memory

# Server Port
PORT=5000
